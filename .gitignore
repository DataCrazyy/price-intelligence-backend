# Entorno virtual de Python
venv/
__pycache__/
*.pyc

# Secretos -- nunca versionar
.env
*.env

# Respaldo .xlsx de cada corrida de scraping (se regenera solo, pesa mucho)
scrapes_raw/

# Reportes PDF generados (son output, no código)
reportes/
*.pdf

# Archivos de trabajo temporales
_fix_config.py

# Exports de datos sueltos generados a mano (export_json.py sin argumento
